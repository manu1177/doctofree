{% extends 'admin/base.html.twig' %}

{% block title %}Rendezvous index
{% endblock %}

{% block admin_content %}
	<h1 class="my-5 text-center text-danger">Rendez-vous</h1>

	<table class="table">

		<tbody>
			{% for rendezvous in rendezvouses %}
				<ul>

					<li>{{ rendezvous.dateHeure ? rendezvous.dateHeure|date('Y-m-d H:i:s') : '' }}
						{{ rendezvous.dureeMinutes }}<a class="mx-5" href="{{ path('app_admin_rendezvous_show', {'id': rendezvous.id}) }}">show</a>
					</li>


					{# <a href="{{ path('app_admin_rendezvous_edit', {'id': rendezvou.id}) }}">edit</a> #}

				</ul>
			{% else %}
				<tr>
					<td colspan="6">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<a href="{{ path('app_admin_rendezvous_new') }}">Create new</a>
{% endblock %}
