{% extends 'admin/base.html.twig' %}

{% block title %}Rendezvous{% endblock %}

{% block admin_content %}
    <h1>Rendezvous</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ rendezvou.id }}</td>
            </tr>
            <tr>
                <th>Date_heure</th>
                <td>{{ rendezvou.dateHeure ? rendezvou.dateHeure|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Duree_minutes</th>
                <td>{{ rendezvou.dureeMinutes }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ rendezvou.statut }}</td>
            </tr>
            <tr>
                <th>Motif</th>
                <td>{{ rendezvou.motif }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_rendezvous_index') }}">back to list</a>

    <a href="{{ path('app_admin_rendezvous_edit', {'id': rendezvou.id}) }}">edit</a>

    {{ include('admin/rendezvous/_delete_form.html.twig') }}
{% endblock %}
