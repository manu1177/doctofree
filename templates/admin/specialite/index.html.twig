{% extends 'admin/base.html.twig' %}

{% block title %}Specialite index{% endblock %}

{% block admin_content %}
    <h1 class="my-5 text-center text-danger">Specialités</h1>

    
       
        <tbody>
        {% for specialite in specialites %}
            <ul>
                
                <li>{{ specialite.libelle }}  <a class="mx-5" href="{{ path('app_admin_specialite_show', {'id': specialite.id}) }}">show</a></li>
             
               
                  
                    {# <a href="{{ path('app_admin_specialite_edit', {'id': specialite.id}) }}">edit</a> #}
              
            </ul>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_admin_specialite_new') }}">Create new</a>
{% endblock %}
